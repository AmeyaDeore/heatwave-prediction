# Node.js application API config template (Part 01 Revision 2). Copy to server/.env.
# server/.env is git-ignored. NEVER put real secrets in this file.
# Inventory and ownership: docs/configuration-and-secrets.md

# --- General ---
APP_ENV=local                      # local | test | staging | production
LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR
PORT=4000                          # the ML service (FastAPI) keeps 8000

# --- MongoDB (Part 08 R2) ---
# The database name in the path is required. Local uses its own database, never another project's.
MONGODB_URI=mongodb://127.0.0.1:27017/heatwave_local

# --- Auth (used from Revision 2 step 5, Part 15 R2) ---
# Refused outside local/test while it is the placeholder or shorter than 32 characters.
# generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-local-only
JWT_TTL_MINUTES=60

# --- ML inference service (used from Revision 2 step 4, Part 07 §A) ---
ML_SERVICE_URL=http://localhost:8000
# Refused outside local/test while it is the placeholder or shorter than 32 characters.
ML_SERVICE_TOKEN=change-me-local-only

# --- CORS (used from Revision 2 step 5, when the frontend switches to this API) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173   # comma-separated origins

# --- Shared config and limits (Revision 2 step 4) ---
MONITORED_REGIONS_FILE=config/regions.yaml   # relative to the repository root, as for the Python services
ML_SERVICE_TIMEOUT_MS=30000                  # per call to the ML service; then ML_SERVICE_UNAVAILABLE
RATE_LIMIT_PREDICT_PER_MINUTE=30             # POST /predict and /predictions/batch, per client IP

# --- Login (Revision 2 step 5, Part 15 R2) ---
RATE_LIMIT_LOGIN_PER_MINUTE=10     # per client IP
LOGIN_LOCKOUT_FAILURES=10          # consecutive failures on one username before it is locked
LOGIN_LOCKOUT_MINUTES=15
# local/test only: a demo official is seeded with these. Never set in staging/production (it is
# deactivated there). Real accounts: npm run users -- create <username> --name "..."
DEMO_USER_USERNAME=official
DEMO_USER_PASSWORD=demo-official-local
