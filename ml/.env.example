# ML pipeline environment template. Copy to ml/.env and fill in local values.
# ml/.env is git-ignored. NEVER put real secrets in this file.
# Relative paths resolve from the repository root.
# Living document: Parts 02-06 add variables here as they need them.

# --- General ---
APP_ENV=local
LOG_LEVEL=INFO
RANDOM_SEED=42

# --- Data locations (Part 02/03) ---
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
SAMPLE_DATA_DIR=data/sample

# --- Weather sources (Part 02) ---
# All three are public and keyless. See docs/decisions/0002-data-sources.md.
MONITORED_REGIONS_FILE=config/regions.yaml
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/daily/point
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
IMD_GRIDDED_TMAX_URL=https://www.imdpune.gov.in/cmpg/Griddata/maxtemp.php
IMD_FETCH_MODE=auto                # auto = inbox first, then HTTP | inbox | http
IMD_INBOX_DIR=data/raw/imd/_inbox  # drop hand-downloaded Maxtemp_MaxT_<year>.GRD files here

# --- Date ranges (Part 02) ---
TRAINING_START_DATE=2000-01-01
TRAINING_END_DATE=2024-12-31
IMD_HISTORY_START_YEAR=1991        # 1991-2020 is the 30-year window for seasonal normals
NASA_POWER_RECENT_DAYS=14          # rolling window of recent observations for live inference
FORECAST_DAYS=3                    # "next 1-3 days" prediction horizon
SYNTHETIC_RECORD_COUNT=5000

# --- Ingestion resilience (Part 02) ---
INGEST_HTTP_TIMEOUT_SECONDS=60
INGEST_MAX_ATTEMPTS=4              # per request, including the first try
INGEST_BACKOFF_BASE_SECONDS=2      # doubles each retry, capped at 60s

# --- Preprocessing & feature engineering (Part 03) ---
# See docs/data/preprocessing.md. RANDOM_SEED (above) seeds the generator and the split.
SEASONAL_NORMALS_FILE=config/seasonal_normals.csv   # IMD 1991-2020 normals; also read at inference
MODELING_DATASET_PATH=data/heatwave_dataset.csv     # manifest is written beside it
TEST_FRACTION=0.15
VALIDATION_FRACTION=0.15

# --- Model output (Parts 04-06) ---
MODEL_ARTIFACT_DIR=ml/artifacts
RISK_CONFIG_PATH=config/risk_classes.yaml   # shared with backend/, defined once
