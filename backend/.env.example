# Backend environment template. Copy to backend/.env and fill in local values.
# backend/.env is git-ignored. NEVER put real secrets in this file.
# Relative paths resolve from the repository root.
# Living document: Parts 07, 09, 15 and 18 add variables here as they need them.

# --- General ---
APP_ENV=local                      # local | staging | production | test
LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR

# --- Database (Part 08) ---
# SQLite for local/demo. Postgres later, e.g. postgresql+psycopg://user:pass@host/db  # pragma: allowlist secret
DATABASE_URL=sqlite:///data/local/heatwave.db

# --- Model serving (Parts 05-07) ---
# Loaded once at startup; the service refuses to start if the model or its explainer
# is missing or stale. A new production model is picked up by restarting.
MODEL_ARTIFACT_DIR=ml/artifacts
MODEL_REGISTRY_DIR=ml/registry     # production.json = the promoted model (Part 05)
MODEL_VERSION=production           # follow the registry pointer, or pin an exact version id
RISK_CONFIG_PATH=config/risk_classes.yaml   # shared with ml/, defined once
MONITORED_REGIONS_FILE=config/regions.yaml
SEASONAL_NORMALS_FILE=config/seasonal_normals.csv
RECOMMENDED_ACTIONS_FILE=config/recommended_actions.yaml

# --- HTTP (Part 07) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173  # comma-separated list
# Per client address and per process; "0/minute" disables a limit.
RATE_LIMIT_PREDICT=30/minute
RATE_LIMIT_ALERT_WRITES=10/minute
RATE_LIMIT_LOGIN=5/minute

# --- Auth (Part 15) ---
# Required (>= 32 random characters) when APP_ENV is staging or production.
AUTH_SECRET_KEY=change-me-local-only        # generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_TOKEN_TTL_MINUTES=60
AUTH_REQUIRED_FOR_READS=false      # true: dashboard reads also need a token (writes always do)

# --- Notifications (Part 09) ---
NOTIFICATIONS_MODE=mock            # mock = log only, nothing is sent | live = real providers (Part 09)
NOTIFICATIONS_MOCK_FAIL_CHANNELS=  # mock only: channels to report as FAILED, e.g. EMERGENCY_SERVICES
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=

# --- Weather source for live inference (Parts 02, 07) ---
# The live forecast comes from Part 02's Open-Meteo adapter and is stored in
# weather_snapshots; a stored forecast younger than WEATHER_CACHE_MINUTES is reused.
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
WEATHER_HTTP_TIMEOUT_SECONDS=10
WEATHER_MAX_ATTEMPTS=2
WEATHER_CACHE_MINUTES=60
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/daily/point
