# Frontend build-time config template. Copy to frontend/.env.local.
# Everything here is compiled into the public JS bundle, so NEVER put secrets in it.
# The VITE_ prefix assumes Vite. If Part 10 picks a different build tool, rename the prefix.

VITE_API_BASE_URL=http://localhost:8000
VITE_DEFAULT_REGION=mumbai
VITE_DASHBOARD_POLL_INTERVAL_MS=60000
